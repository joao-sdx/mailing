  "noapprovalemails": 0,
  "vat_id": "",
  "registration_number_1": "",
  "addresslevel2a": "",
  "addresslevel3a": "",
  "addresslevel4a": "",
  "addresslevel5a": "",
  "addresslevel6a": "",
  "addresslevel7a": "",
  "addresslevel8a": "",
  "verification": "",
  "buildingnumbera": "",
  "localnumbera": "",

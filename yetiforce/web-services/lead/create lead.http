  "legal_form": "",
  "crmactivity": "",
  "private": 0,
  "phone_extra": "",
  "mobile_extra": "",
  "fax_extra": ""
}

> {%







    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.global.set("company_id", response.body.result.id);
    });







%}


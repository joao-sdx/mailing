### create one approval
# cannot set accout as its id is created only after transformation
POST https://{{CRM_URL}}/webservice/WebserviceStandard/ApprovalsRegister/Record
Authorization: Basic {{wsAppName}} {{wsAppPass}}
X-API-KEY: {{wsApiKey}}
X-TOKEN: {{token}}
Accept: application/json
Content-Type: application/json

{
  "subject": "{{company}} - Use documents for service optimization.",
  "approvalsid": 140,
  "contactid": {{contact_id}},
  "approvals_register_status": "PLL_ACCEPTED",
  "approvals_register_type": "PLL_ACCEPTANCE",
  "registration_date": "{{now}}",
  "description": "Right to use documents for service optimization purposes"
}

### create one approval
# cannot set accout as its id is created only after transformation
POST https://{{CRM_URL}}/webservice/WebserviceStandard/ApprovalsRegister/Record
Authorization: Basic {{wsAppName}} {{wsAppPass}}
X-API-KEY: {{wsApiKey}}
X-TOKEN: {{token}}
Accept: application/json
Content-Type: application/json

{
  "subject": "{{company}} - GDPR disclaimer.",
  "approvalsid": 156,
  "contactid": {{contact_id}},
  "approvals_register_status": "PLL_ACCEPTED",
  "approvals_register_type": "PLL_ACCEPTANCE",
  "registration_date": "{{now}}",
  "description": "Disclaimer for GDPR-related documents"
}
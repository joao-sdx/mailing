### get token
#
# wsAppName wsAppPass and wsApiKey are defined in index.php?module=WebserviceApps&view=Index&parent=Settings
# wsApiKey is generated by and must be copied from page
#
# wsUserName and wsUserPass are defined in index.php?module=WebserviceUsers&view=List&parent=Settings
# wsUserName is login as displayed in UI (not associated user code)
# wsUserPass is the password as created here (not associated user password)
#
POST https://{{CRM_URL}}/webservice/WebserviceStandard/Users/Login
Accept: application/json
Authorization: Basic {{wsAppName}} {{wsAppPass}}
X-API-KEY: {{wsApiKey}}
Content-Type: application/json

{
    "userName": "{{wsUserName}}",
    "password": "{{wsUserPass}}"
}

> {%







    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.global.set("token", response.body.result.token);
    client.global.set("company", "EcoMobilis Test");
    client.global.set("contact_first_name", "Gerad");
    client.global.set("contact_last_name", "Lefortest");
    client.global.set("contact_email", "glefortest-test@nowhere.noop");
    client.global.set("now", new Date().toISOString().slice(0, 19).replace('T', ' '));







%}


### create one lead
